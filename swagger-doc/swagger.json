{
  "openapi" : "3.0.0",
  "info" : {
    "title" : "Contact API",
    "description" : "This is an APi that stores contact information.",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "https://cse341-hq1b.onrender.com/contacts"
  } ],
  "paths" : {
    "/contacts/{contactId}" : {
      "get" : {
        "summary" : "Returns a contact by ID",
        "parameters" : [ {
          "name" : "contactId",
          "in" : "path",
          "description" : "The ID of the contact to return",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "properties" : {
                    "id" : {
                      "type" : "string"
                    },
                    "name" : {
                      "type" : "string"
                    }
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "The specified contact ID is invalid (e.g. not a number)"
          },
          "404" : {
            "description" : "A contact with the specified ID was not found"
          }
        }
      }
    }
  }
}